<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light-Theme: WebView meldet der Seite dann prefers-color-scheme: light -->
    <style name="Theme.Lotto" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/hintergrund</item>
        <item name="android:colorAccent">@color/akzent</item>
        <item name="android:statusBarColor">@color/hintergrund</item>
        <item name="android:navigationBarColor">@color/hintergrund</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
