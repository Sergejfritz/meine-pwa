<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/inhalt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:text="🔊 Vorlesen"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="In jeder App Text markieren → runder Knopf erscheint → antippen = vorlesen, nochmal = stopp."
            android:textColor="@color/text_leise"
            android:textSize="15sp" />

        <!-- Schritt 1: Knopf einschalten -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/karte"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusHilfe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/text_leise"
                android:textSize="14sp" />

            <Button
                android:id="@+id/einschalten"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/knopf"
                android:text="Knopf einschalten"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/gesperrt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="6dp"
                android:text="Schalter ausgegraut („Eingeschränkte Einstellung“)? Hier tippen → App-Info → oben rechts ⋮ → „Eingeschränkte Einstellungen zulassen“. Dann nochmal „Knopf einschalten“."
                android:textColor="@color/akzent"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ausprobieren -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hier ausprobieren"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/karte"
            android:fontFamily="serif"
            android:gravity="top|start"
            android:hint="Text eintippen oder einfügen …"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingMultiplier="1.2"
            android:minLines="5"
            android:padding="16dp"
            android:text="Hallo! Markiere ein paar Wörter in diesem Text – dann erscheint der runde Knopf. Tippe darauf, und ich lese dir die Markierung vor."
            android:textColor="@color/text"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/allesVorlesen"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/knopf"
                android:text="▶ Alles vorlesen"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/einfuegen"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/karte"
                android:text="📋 Einfügen"
                android:textAllCaps="false"
                android:textColor="@color/text" />
        </LinearLayout>

        <!-- Einstellungen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/karte"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙ Stimme &amp; Tempo"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Stimme"
                android:textColor="@color/text_leise" />

            <Spinner
                android:id="@+id/stimme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tempoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_leise" />

            <SeekBar
                android:id="@+id/tempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="15" />

            <TextView
                android:id="@+id/hoeheText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_leise" />

            <SeekBar
                android:id="@+id/hoehe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10" />

            <Button
                android:id="@+id/stimmenInstallieren"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/karte"
                android:text="Weitere / bessere Stimmen (Android-Sprachausgabe)"
                android:textAllCaps="false"
                android:textColor="@color/text" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.15"
            android:text="Tipp: Wenn der Knopf in einer App nicht erscheint (manche Apps melden ihre Markierung nicht), tippe im Markier-Menü auf ⋮ → „Vorlesen“ oder auf Teilen → „Vorlesen“.\n\nDatenschutz: Kein Internet, nichts wird gespeichert oder verschickt. Gesprochen wird mit der Sprachausgabe deines Handys."
            android:textColor="@color/text_leise"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
