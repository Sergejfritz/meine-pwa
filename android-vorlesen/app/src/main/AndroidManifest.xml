<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vorlesen läuft weiter, auch wenn man die App verlässt (mit Stopp-Knopf in der Benachrichtigung) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sprachausgabe des Handys finden (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Vorlesen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- „Vorlesen“ im Markier-Menü jeder App (⋮) und im Teilen-Menü -->
        <activity
            android:name=".VorlesenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/menue_eintrag"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Vorlesen.Unsichtbar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Der runde Knopf: erkennt Markierungen in allen Apps (Bedienungshilfe) -->
        <service
            android:name=".MarkierDienst"
            android:exported="true"
            android:label="@string/dienst_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/markier_dienst" />
        </service>

        <service
            android:name=".SprechDienst"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
